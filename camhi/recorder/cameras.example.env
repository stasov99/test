# Три камеры PS-Link (4G, каждая со своей SIM). Скопируй в cameras.env и заполни.
# UID берётся из приложения CamHi (Settings → Device Info / или на наклейке).
# Пароль — тот, что ты задал камере в CamHi.

# cam1
CAM1_NAME=cam1
CAM1_UID=XXXX-123456-ABCDE
CAM1_PASS=changeme

# cam2
CAM2_NAME=cam2
CAM2_UID=XXXX-234567-BCDEF
CAM2_PASS=changeme

# cam3
CAM3_NAME=cam3
CAM3_UID=XXXX-345678-CDEFG
CAM3_PASS=changeme

# --- облако (rclone remote) ---
# Создай remote: rclone config  (S3/B2/Я.Облако/любой).
RCLONE_REMOTE=cloud:camhi

# Сколько дней хранить записи в облаке (ротация, старше — удаляются).
RETENTION_DAYS=14
